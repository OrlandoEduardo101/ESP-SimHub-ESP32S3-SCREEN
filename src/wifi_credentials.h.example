// Copy this file to wifi_credentials.h (same directory) and fill in your
// own network. wifi_credentials.h is gitignored — it never reaches the
// repo, so your password stays local.
//
// Why plain credentials instead of a WiFiManager captive portal like the
// screen uses: the portal runs AP + DNS server + web server all at once,
// which is a different power profile than the plain WiFi.begin() this
// project actually load-tested on the wheel (see git log "WiFi survival
// test" — 8s post-boot, ~20s of association attempts, no brownout). The
// portal's AP-mode broadcast + concurrent servers hasn't been tested on
// this board's power rail, and given this wheel's documented BLE brownout
// history, that's not a good thing to find out live. Plain STA is the
// smaller, already-proven bet.
#pragma once

#define WHEEL_WIFI_SSID     "your-network-name"
#define WHEEL_WIFI_PASSWORD "your-network-password"
